{
  "name": "carecircle",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently -n FRONTEND,BACKEND -c cyan,green \"npm run dev --prefix client\" \"npm run dev --prefix server\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "build": "npm run build --prefix client",
    "test": "npm run test:family && npm run test:client",
    "test:client": "npm run test --prefix client",
    "test:api": "node --test tests/integration/family-api.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm test && npm run test:api && npm run test:e2e",
    "test:settings": "node --test tests/unit/family-settings.test.mjs tests/unit/settings-account.test.mjs",
    "test:family": "node --test tests/unit/family-settings.test.mjs tests/unit/settings-account.test.mjs tests/unit/family-workspace.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "concurrently": "^9.1.2"
  }
}
